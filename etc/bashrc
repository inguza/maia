###################################################################################
# Load the general bashrc
###################################################################################
if [[ -e "$HOME/.bashrc" ]] ; then
   . "$HOME/.bashrc"
fi

###################################################################################
# specific maia functionality
###################################################################################
# Alias to set the session in a way that save keystrokes
maias() {
    export MAIA_SESSION="$1"
}
# Prompt visibility
if [[ -n "$MAIA_PS1" ]] ; then
    PS1="$MAIA_PS1"
fi
maia_prompt_helper() {
    MAIA_PROMPT_SESSION=$(maia --query session)
    MAIA_PROMPT_WORKSPACE=$(maia --query workspace)
}
if [[ "$PROMPT_COMMAND" != *maia_prompt_helper* ]]; then
    if [[ -z "$PROMPT_COMMAND" ]] ; then
	PROMPT_COMMAND="maia_prompt_helper > /dev/null 2>&1 || true"
    else
	PROMPT_COMMAND+=$'\n'"maia_prompt_helper > /dev/null 2>&1 || true"
    fi
fi
# Bash completions
. "${MAIA_ROOT}/etc/bash.completions"
# Utility function to do something for every session
maiaforeachsession() {
    local filter="$1"
    shift
    maia session list |
        sed 's/^[\*+ \t]*//;s/[ \t].*$//;s/\r\n/\n/;' |
        while read -r w || [[ -n "$w" ]] ; do
            [[ -n "$w" ]] || continue
            [[ "$w" == $filter ]] || continue
            maias $w
            local command
            for command in "$@" ; do
                eval "$command"
            done
        done
}
