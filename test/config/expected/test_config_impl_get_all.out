CONFIG NAME                    SCOPE      VALUE
----------------------------------------------------------------------------
additional_skill_paths         default    ""
additional_tool_paths          default    ""
api_base_url                   default    "https://api.openai.com"
api_type                       default    "AUTODETECT"
auto_add_new_files_on_apply    default    true
auto_parse                     default    false
default_filter                 default    ""
default_session_extra_send_filesets default    "[]"
default_session_filesets       default    "[\"__SESSION_NAME__\"]"
default_workspace              default    "__SESSION_WORKSPACE__"
file_handling_mode             default    "DEFAULT"
frequency_penalty              default    0
http_logging                   default    true
max_input_tokens               default    64000
max_output_tokens              default    32000
model                          default    "gpt-4.1-mini"
n                              default    1
presence_penalty               default    0
prune_mode                     default    "reduce"
prune_when_applied             default    true
prune_when_skipped             default    true
send_hook                      default    ""
splice_allowed_files           default    "\\.(?:py|c|cpp|php|js|pl|pm|sh|txt)$"
stream                         default    false
tab_width                      default    8
temperature                    default    0.7
term_loglevel                  home       "NOTICE"
top_p                          default    1

ENVIRONMENT NAME               VALUE
----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID              ********************************
AWS_SECRET_ACCESS_KEY          ********************************
AWS_SESSION_TOKEN              ********************************
OPENAI_API_KEY                 ********************************
