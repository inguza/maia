  {
    "name": "web-browser-curl",
    "description": "Tool for transferring data from or to a server.",
    "command": "curl.sh -i -D -G --get --raw -s -S -X POST",
    "inputSchema": {
      "type": "object",
      "properties": {
        "urls": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "One or more URLs."
        },
        "header": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "header/@file"
          }
        },
        "data": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "POST data. @file reads data from a file."
          }
        },
        "data-raw": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "POST data."
          }
        },
        "data-binary": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "POST data as is."
          }
        },
        "json": {
          "type": "string",
          "description": "Sends the specified JSON data in a POST request to the HTTP server."
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of curl command line arguments. Allowed are: -i -D -G --get --raw -s -Sx -X POST."
        }
      },
      "required": [
        "urls"
      ],
      "additionalProperties": false
    },
    "source": "<MAIA_ROOT>/lib/maia/tools/curl.td"
  },
  {
    "name": "file-write",
    "description": "Write content to a file. If the file does not exist, it is created. If the file already exists, a change proposal is created instead and the file is not modified.",
    "command": "file-write.sh",
    "instructions": [
      "file.txt"
    ],
    "effects": [
      "limited-write"
    ],
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "Path of the file to write."
        },
        "content": {
          "type": "string",
          "description": "The full content to write to the file. If omitted, content is read from stdin."
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
    "source": "<MAIA_ROOT>/lib/maia/tools/file.td"
  },
  {
    "name": "file-append",
    "description": "Append content to the end of a file. The file is modified directly and no change proposal is created.",
    "command": "file-append.sh",
    "instructions": [
      "file.txt"
    ],
    "effects": [
      "limited-write"
    ],
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "Path of the file to append to."
        },
        "content": {
          "type": "string",
          "description": "The content to append to the file. If omitted, content is read from stdin."
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
    "source": "<MAIA_ROOT>/lib/maia/tools/file.td"
  },
  {
    "name": "file-change",
    "description": "Update an existing file by making exact literal text replacements. Always creates a change proposal.",
    "command": "file-change.sh",
    "instructions": [
      "file.txt",
      "file-change.txt"
    ],
    "effects": [
      "limited-write"
    ],
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "File to update."
        },
        "changes": {
          "type": "array",
          "description": "A list of exact text replacements. Each change replaces one exact, contiguous region of the current file.",
          "items": {
            "type": "object",
            "properties": {
              "existing": {
                "type": "string",
                "description": "The exact text currently present in the file. Matching is literal; whitespace and every other character matter. The text must occur exactly once in the current file."
              },
              "replacement": {
                "type": "string",
                "description": "The exact text to insert in place of `existing`. All other file content remains unchanged."
              }
            },
            "required": [
              "existing",
              "replacement"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "path",
        "changes"
      ],
      "additionalProperties": false
    },
    "source": "<MAIA_ROOT>/lib/maia/tools/file.td"
  },
  {
    "name": "context-file-remember",
    "description": "Add a files to the known context",
    "command": "context-file-remember.sh",
    "instructions": [
      "context-file-remember.txt"
    ],
    "inputSchema": {
      "type": "object",
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "File(s) to add to the currently known context. Glob pattern matching can be used to match files."
          }
        },
        "linestart": {
          "type": "string",
          "description": "First line to remember when only part of the file is needed."
        },
        "lineend": {
          "type": "string",
          "description": "Last line to remember when only part of the file is needed."
        }
      },
      "required": [
        "files"
      ],
      "additionalProperties": false
    },
    "source": "<MAIA_ROOT>/lib/maia/tools/file.td"
  },
  {
    "name": "context-file-forget",
