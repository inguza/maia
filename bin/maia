set -o pipefail
shopt -s nullglob
shopt -s extglob

maia_bin_path="$(command -v "$0")"
maia_real_path="$(realpath "$maia_bin_path")"
export MAIA_ROOT="$(dirname "$(dirname "$maia_real_path")")"
export MAIA_BIN="$maia_real_path"
export MAIA_CORE_LIB_DIR="$MAIA_ROOT/lib/maia/core"
export MAIA_TOOLS_LIB_DIR="$MAIA_ROOT/lib/maia/tools"
export MAIA_SKILLS_LIB_DIR="$MAIA_ROOT/lib/maia/skills"
export MAIA_HOOKS_LIB_DIR="$MAIA_ROOT/lib/maia/hooks"
#
# Fast handling of session and workspace query
#
COMMAND="${1:-}"
if [[ "$COMMAND" == "--query" ]] ; then
    . "$MAIA_CORE_LIB_DIR/fast.sh"
    shift
    Q="${1:-}"
    case "$Q" in
	session)
	    # Copy code from session.sh "" case
	    session="$(resolve_session_name)"
            meta="$(resolve_session_meta)"
	    if [[ ! -e "$meta" ]] ; then
                session+="!"
	    fi
            echo "$session"
            ;;
	workspace)
	    # Copy code from workspace.sh "" case
	    workspace="$(resolve_workspace_name)"
	    if [[ -n "$workspace" ]] ; then
		meta="$(resolve_workspace_meta)"
		if [[ ! -e "$meta" ]] ; then
		    workspace+="!"
		else
		    wpath="$(resolve_workspace_root)"
		    if [[ "$PWD" == "$wpath" || "$PWD" == "$wpath/"* ]]; then
			:
		    else
			workspace+="§"
		    fi
		fi
	    else
		workspace="-"
	    fi
	    echo "${workspace}"
	    ;;
	nop)
	    :
	    ;;
    esac
    exit
fi

# Load shared utilities
. "$MAIA_CORE_LIB_DIR/common.sh"
# Load merged config up to history scope
_cfg=$(load_merged_config session)
export TERM_LOGLEVEL=$(echo "$_cfg" | jq -r '.term_loglevel')

# Check for required tools
require_command curl
require_command jq

# If no arguments, show help
if [[ $# -eq 0 ]]; then
    COMMAND=""
fi

version() {
    local VER=$(cat "$MAIA_CORE_LIB_DIR/version")
    echo $VER
}

# Resolve the active history (use "default" if not set)
usage() {
    cat <<EOF
Usage: maia <command> [options] [<text-or-file>...]
       maia [<text-or-file>...]

Manage the message to send to the AI.

COMMANDS:

  Configuration / General
    config           Configuration (list, scope, get, set, unset)
    home             Manage maia home directory (create, delete, show)
    api              AI introspection (models, model, fine-tunes, fine-tune, usage)

  Session and prompt handling
    session          Session management (create, use, list, show)
    send|s           Send prompt to API (with dry-run, response-file options)
    user|u|outbox    User outbox management (show, append, replace, clear, delete)
    count            Estimate token count for API payload
    system           System prompt management (show, append, replace, clear)
    [+]edit          An alias of 'maia user +edit'
    [+]compose	     An alias of 'maia send +compose'
    +read	     An alias of 'maia send +read'
    +run	     An alias of 'maia send +run'
    +shell	     An alias of 'maia send +shell'

  Context handling
    history|h        History operations (show, pop, top, delete, search, clear, export)
    filesets|fileset Fileset management (list, create, delete, show, clear)
    files|file|f     File management (add, forget, remove)
    toolset|tools|tool Tool management (list, enable/append, replace, disable, clear, delete)
    skill	     Skill management (list, show, remember, append, replace, clear, test, refresh, verify, delete)

  Workspace and change handling
    workspace|w      Workspace management (create, use, show, list, clear, delete)
    parse            Parse assistant response and produce change suggestions [DEPRECATED]
    change|c         Change management (list, show, edit, gen, apply, applied, delete, skip)

  Shell and execution handling
    shell            Shell management (in development)
    job		     Background job management (start, status, output, list, cancel)

OPTIONS:

  -h, --help        Show this help message and exit
  --version         Show version information and exit

ENVIRONMENT:

  Authentication:
  - OPENAI_API_KEY
  - AWS_ACCESS_KEY_ID
  - AWS_SECRET_ACCESS_KEY
  - AWS_SESSION_TOKEN
  - MAIA_CURL_EXTRA_HEADERS

  Editor:
  - MAIA_EDITOR
  - EDITOR

  Session select:
  - MAIA_SESSION

EXAMPLES:

 Command examples:

  maia send "Hello, AI!"
    Send the message "Hello, AI!" to the AI API.

  maia fileset list
    List all filesets in the current workspace.

  maia change list --pending
    List all pending changes.

  maia compose
    Open an editor where instructions are given and then send that to the AI API.

  maia
    Show the outbox.

 Environment examples:

  export OPENAI_API_KEY='xxxxxx'
  export MAIA_CURL_EXTRA_HEADERS=\$'X-My-Auth: mytoken\nX-Another-Header: value'
  export MAIA_EDITOR="emacs -nw"
  export MAIA_SESSION="somesessionname"

NOTES:

  When maia [<text-or-file>] alternative is detected it is treated as
  'maia user append [<text-or-file>]' except that the <text-or-file> must start
  with a capital letter or be a quoted string with at least one space.
  This helps differentiate commands from user input.

  <text-or-file> can be:
    - a word
    - a "quoted text"
    - +command (compose, read, edit, run, shell)
      compose:
        Open an editor and create a new text
      read:
        Read from stdin.
      edit:
        Edit existing text.
      run:
        If `+run` then it takes the last shell change run output.
	If `+"run <changeid>"` then it takes the output of that specific shell change run.
      shell:
        If `+shell` then it takes the output of the active (or default) monitored shell.
	IF `+"shell <shellname>"` then it takes the output of that specific monitored shell.
    - =filename (content of a file)
    - ++word (litteral +word)
    - ==word (litteral =word)
    - @snippet
  If multiple are provided they are appended as new lines (except for edit
  which opens the editor inline).

  This example command:
     maia send "This is the error message:" compose " followed by:" compose
  will send the following to the AI:
     This is the error message:
     <the composed text from the editor>
     followed by:
     <the composed text from the second editor>

EOF
    exit 0
}

case "$COMMAND" in
    home)
	shift
	. "$MAIA_CORE_LIB_DIR/home.sh"
	handle_home_command "$@"
	;;
    debug)
	;;
    user|u|outbox)
	shift
	. "$MAIA_CORE_LIB_DIR/user.sh"
	handle_user_command "$@"
	;;
    system)
	shift
	. "$MAIA_CORE_LIB_DIR/system.sh"
	handle_system_command "$@"
	;;
    snippets|snippet|snip)
	shift
	. "$MAIA_CORE_LIB_DIR/snippet.sh"
	handle_snippet_command "$@"
	;;
    session)
	shift
	. "$MAIA_CORE_LIB_DIR/session.sh"
	handle_session_command "$@"
	;;
    job)
	shift
	. "$MAIA_CORE_LIB_DIR/job.sh"
	handle_job_command "$@"
	;;
    history|h)
	shift
	. "$MAIA_CORE_LIB_DIR/history.sh"
	handle_history_command "$@"
	;;
    workspace|ws|w)
	shift
	. "$MAIA_CORE_LIB_DIR/workspace.sh"
	handle_workspace_command "$@"
	;;
    tools|tool)
	shift
	. "$MAIA_CORE_LIB_DIR/tool.sh"
	handle_tool_command "$@"
	;;
    skill)
	shift
	. "$MAIA_CORE_LIB_DIR/skill.sh"
	handle_skill_command "$@"
	;;
    shell)
	shift
	. "$MAIA_CORE_LIB_DIR/shell.sh"
	handle_shell_command "$@"
	;;
    files|file|f)
	shift
	. "$MAIA_CORE_LIB_DIR/file.sh"
	handle_file_command "$@"
	;;
    parse)
	shift
	. "$MAIA_CORE_LIB_DIR/parse.sh"
	handle_parse_command "$@"
	;;
    filesets|fileset)
	shift
	. "$MAIA_CORE_LIB_DIR/fileset.sh"
	handle_fileset_command "$@"
	;;
    config)
	shift
	. "$MAIA_CORE_LIB_DIR/config.sh"
	handle_config_command "$@"
	;;
    api)
	shift
	. "$MAIA_CORE_LIB_DIR/api.sh"
	handle_api_command "$@"
	;;
    send|s)
	shift
	. "$MAIA_CORE_LIB_DIR/send.sh"
	handle_send_command "$@"
	;;
    count)
	shift
	. "$MAIA_CORE_LIB_DIR/count.sh"
	handle_count_command "$@"
	;;
    change|c)
	shift
	. "$MAIA_CORE_LIB_DIR/change.sh"
	handle_change_command "$@"
	;;
    help|--help|-h)
	usage
	exit 0
	;;
    version|--version)
	version
	exit 0
	;;
    "")
	. "$MAIA_CORE_LIB_DIR/user.sh"
	handle_user_command show
	;;
    edit|+edit)
	. "$MAIA_CORE_LIB_DIR/user.sh"
	handle_user_command "$@"
	;;
    compose|+compose)
	shift
	. "$MAIA_CORE_LIB_DIR/send.sh"
	handle_send_command "+compose" "$@"
	;;
    *)
	. "$MAIA_CORE_LIB_DIR/send.sh"
	handle_send_command "$@"
	;;
esac
exit 0
